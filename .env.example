# Copy to .env and fill in what you need. Empty means unset. Variables set in
# the environment take precedence over this file. See README.md for details.

# Custom domain to publish the Worker to, such as go.example.com.
DOMAIN=

# Worker name. Defaults to vanity.
WORKER_NAME=

# Manual modules as JSON, such as {"foo":"https://example.com/you/foo"}.
MODULES=

# Forge plugin used for discovery, such as github. Unset for manual only.
FORGE=

# User or organization whose repositories are discovered. Required with FORGE.
FORGE_OWNER=

# Topic a repository needs to be published. Defaults to go.
FORGE_TOPIC=

# Forge API base URL, for self-hosted instances.
FORGE_URL=

# Optional forge token, uploaded as a secret. Raises the rate limit.
FORGE_TOKEN=

# Seconds to cache forge answers. 0 disables caching. Defaults to 3600.
CACHE_TTL=
